# CampusCare Backend Environment Configuration Template
APP_NAME=CampusCare
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campuscare_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_LIFETIME=7200
CSRF_SECRET=campuscare_replace_with_a_secure_random_key_64_chars_min
CORS_ALLOWED_ORIGIN=http://localhost:8080
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=300

# File Upload Configuration (5MB default limit)
UPLOAD_MAX_BYTES=5242880
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf
